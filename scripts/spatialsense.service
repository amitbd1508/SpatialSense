[Unit]
Description=SpatialSense Privacy-First Spatial Intelligence Edge Engine
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/spatialsense
ExecStart=/home/pi/spatialsense/venv/bin/python backend/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
